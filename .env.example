# Puerto del servidor de notificaciones
PORT=3001

# ===== Telegram Bot API =====

# Token del bot. Créalo con @BotFather en Telegram:
# 1. Habla con @BotFather -> /newbot -> sigue los pasos.
# 2. Copia el token que te da (formato: 123456:ABC-...).
TELEGRAM_BOT_TOKEN=8871540290:AAFp6hUtBDYWSH1SOHtgg3UhBpgseWgyPYc

# ID del chat donde quieres recibir las notificaciones.
# Para obtenerlo: abre una conversación con tu bot, envíale un
# mensaje cualquiera y luego visita:
# https://api.telegram.org/bot<TU_TOKEN>/getUpdates
# El chat id aparece como "chat":{"id":...}
# Ejemplo: 123456789
TELEGRAM_CHAT_ID=6516503712